# Configuração do NotePi no Raspberry Pi (copiada para /etc/notepi.env pelo instalar.sh)
NOTEPI_DB=/var/lib/notepi/notas.db
NOTEPI_BACKUP_DIR=/mnt/backup
# 1 = recusa fazer backup se o pendrive não estiver montado em NOTEPI_BACKUP_DIR
NOTEPI_BACKUP_EXIGIR_MONTAGEM=1
# Destino do rclone para a cópia na nuvem (ex.: gdrive:NotePi/backup). Vazio = não envia.
NOTEPI_RCLONE_DESTINO=
# Nomes pelos quais o app aceita ser acessado (separados por vírgula). O instalar.sh acrescenta
# aqui o nome do Tailscale (MagicDNS) deste Pi; sem isso o app responde 400 a hosts desconhecidos.
NOTEPI_HOSTS=127.0.0.1,localhost
